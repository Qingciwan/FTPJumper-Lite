<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!--
    注意（踩过的坑）：这里**不要**加
      <System.Windows.Forms.ApplicationConfigurationSection>
        <add key="DpiAwareness" value="PerMonitorV2" />
      </System.Windows.Forms.ApplicationConfigurationSection>
    本程序的 DPI 感知由 app.manifest 的 PerMonitorV2 声明负责。两者同时存在时实测该进程
    反而退化成“DPI 非感知”：窗口被虚拟化成 96 DPI 的逻辑尺寸、Screen.WorkingArea 也变成
    缩放前的虚拟值，布局整体错位（MainForm 里 GetDpiForWindow 也只能拿到 96）。
    因此这里保持空白，真实 DPI 由 MainForm.CurrentDpiScale() 直接查询（见该方法的注释）。
  -->
</configuration>
